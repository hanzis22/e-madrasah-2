# E-Madrasah — environment example
# Salin ke .env (dilakukan admin di server), JANGAN commit .env ke git.
# Gunakan pada production. Nilai kosong = fallback (lihat config/*.php)

# --- Database ---
DB_HOST=localhost
DB_USER=e_madrasah_user
DB_PASS=GANTI_DENGAN_PASSWORD_AMAN
DB_NAME=e_madrasah

# --- Midtrans ---
MIDTRANS_SERVER_KEY=GANTI_ME_SERVER_KEY
MIDTRANS_CLIENT_KEY=GANTI_ME_CLIENT_KEY
# 'true' = production, 'false' = sandbox
MIDTRANS_IS_PRODUCTION=false